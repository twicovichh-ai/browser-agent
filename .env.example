# Copy to .env on the server and fill in. .env is never committed.
ANTHROPIC_API_KEY=
# Random secret for the access link https://<host>/?key=<ACCESS_KEY>  (openssl rand -hex 24)
ACCESS_KEY=
MAX_TASK_COST=1.0
# task = ask with an 'approve all for this task' option; ask = every time; off = never
CONFIRM_MODE=task
